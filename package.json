{
  "name": "inheritance-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Self-custody inheritance vault (dead man's switch) for EVM chains — ETH L2s and BNB",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node --port 8547",
    "scenario": "hardhat run scripts/notify-scenario.ts --network localnode",
    "deploy:baseSepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:bnbTestnet": "hardhat run scripts/deploy.ts --network bnbTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.5",
    "hardhat": "2.29.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
